# Stremio Discord Presence — optional overrides (all have built-in defaults)
# Interval in milliseconds to check whether Stremio is running (default: 5000)
POLL_INTERVAL_MS=5000
# Fast interval while something is playing, so play/pause flips feel instant (default: 2500)
ACTIVE_POLL_INTERVAL_MS=2500
# Seconds of stalled read-progress before guessing Paused (default: 0 = off).
# Only opt in (e.g. 30) if you accept false Paused cards on buffered streams:
# Stremio exposes no play/pause flag, so this is always a guess.
PAUSE_AFTER_SECONDS=0
# Seconds to keep a "Stopped" card after a stream ends, 0 disables (default: 120)
STOP_GRACE_SECONDS=120
# Start with Privacy Mode on (true/false, default: false)
PRIVACY_MODE=false
# GitHub repo to check for updates, "owner/name" (default: the original repo).
# Releases must contain a Windows exe asset for the updater to install it.
UPDATE_REPO=MacroMaster101/Stremio_Discord_Rich_Presence
# Silent update check shortly after launch (true/false, default: true).
# Manual "Check for Updates" always works regardless.
UPDATE_CHECK=true
